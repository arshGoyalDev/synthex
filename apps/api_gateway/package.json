{
  "name": "@synthex/api-gateway",
  "version": "0.0.1",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch --include \"src/**/*.ts\" src/index.ts",
    "build": "tsup src/index.ts --format cjs --out-dir dist",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/index.js"
  },
  "dependencies": {
    "@synthex/database": "workspace:*",
    "@synthex/openapi": "workspace:*",
    "@synthex/templates": "workspace:*",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.0",
    "openapi3-ts": "^4.6.0",
    "socket.io": "^4.8.3",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@synthex/config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/morgan": "^1.9.9",
    "typescript": "^5.3.0"
  }
}
