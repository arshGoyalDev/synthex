{
  "name": "@synthex/user-service",
  "version": "0.0.1",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch --include \"src/**/*.ts\" src/index.ts",
    "build": "tsup src/index.ts --format cjs --out-dir dist",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/index.js"
  },
  "dependencies": {
    "@synthex/database": "workspace:*",
    "@synthex/openapi": "workspace:*",
    "@synthex/templates": "workspace:*",
    "@types/passport": "^1.0.17",
    "@types/passport-github2": "^1.2.9",
    "argon2": "^0.44.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.0",
    "openapi3-ts": "^4.6.0",
    "passport": "^0.7.0",
    "passport-github2": "^0.1.12",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@synthex/config": "workspace:*",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/uuid": "^9.0.0",
    "typescript": "^5.3.0"
  }
}
