{
  "name": "@synthex/container-service",
  "version": "0.0.1",
  "scripts": {
    "dev": "dotenv -e ../../.env -- tsx watch --include \"src/**/*.ts\" src/index.ts",
    "build": "tsup src/index.ts --format cjs --out-dir dist",
    "check-types": "tsc --noEmit -p tsconfig.json",
    "start": "dotenv -e ../../.env -- node dist/index.js"
  },
  "dependencies": {
    "@synthex/database": "workspace:*",
    "@synthex/templates": "workspace:*",
    "archiver": "^7.0.1",
    "cors": "^2.8.5",
    "dockerode": "^4.0.2",
    "express": "^4.18.2",
    "http-proxy-middleware": "^2.0.6",
    "jsonwebtoken": "^9.0.0",
    "socket.io": "^4.7.2",
    "tar-stream": "^3.1.8",
    "uuid": "^9.0.0",
    "zod": "^3.22.0"
  },
  "devDependencies": {
    "@synthex/config": "workspace:*",
    "@types/cors": "^2.8.17",
    "@types/dockerode": "^3.3.31",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/uuid": "^9.0.0",
    "@types/archiver": "^7.0.0",
    "typescript": "^5.3.0"
  }
}
