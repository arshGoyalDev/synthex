{
  "name": "synthex",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:up": "docker-compose --profile infra up -d",
    "db:down": "docker-compose --profile infra down",
    "db:reset": "docker-compose --profile infra down -v && docker-compose --profile infra up -d",
    "db:logs": "docker-compose --profile infra logs -f",
    "db:migrate": "turbo run migrate --filter=@synthex/database",
    "db:generate": "turbo run generate --filter=@synthex/database",
    "db:studio": "turbo run studio --filter=@synthex/database",
    "db:setup": "pnpm run db:up && sleep 5 && pnpm run db:generate && pnpm run db:migrate",
    "docker:build:language-images": "bash scripts/build-language-images.sh"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0",
    "prettier": "^3.7.4",
    "tsup": "^8.5.0",
    "tsx": "^4.20.6",
    "turbo": "^2.8.17",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@10.18.3",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ]
}
