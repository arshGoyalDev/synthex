FROM debian:bookworm-slim

RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        curl \
        wget \
        git \
        ca-certificates \
        openssl \
        tar \
        gzip \
        unzip \
        vim \
        nano \
        procps \
        acl \
        passwd \
        golang \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r synthex && useradd -r -g synthex -m -d /home/synthex synthex

WORKDIR /workspace
RUN mkdir -p /workspace \
    && chown root:synthex /workspace \
    && chmod 2775 /workspace \
    && setfacl -m u:synthex:rwx,g:synthex:rwx,m:rwx /workspace \
    && setfacl -d -m u:synthex:rwx,g:synthex:rwx,m:rwx /workspace

RUN curl -fsSL https://encore.dev/install.sh -o /tmp/encore-install.sh \
    && bash /tmp/encore-install.sh \
    && rm /tmp/encore-install.sh \
    && cp -a /root/.encore /opt/encore \
    && chmod -R a+rX /opt/encore
ENV PATH="/opt/encore/bin:${PATH}"

SHELL ["/bin/bash", "-c"]
