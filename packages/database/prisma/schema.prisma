generator client {
  provider = "prisma-client-js"
  output = "../src/generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProjectType {
  template
  blank
  raw
}

enum ContainerStatus {
  pending
  starting
  stopping
  ready
  stopped
  error
  timeout
}

model User {
  id           String    @id @default(uuid())
  username     String
  email        String    @unique
  passwordHash String    @map("password_hash")
  avatarUrl    String?   @map("avatar_url")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  
  projects      Project[]
  executionLogs ExecutionLog[]
  oauthAccounts OAuthAccount[]

  @@index([email])
  @@map("users")
}

model OAuthAccount {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  provider   String
  providerId String   @map("provider_id")
  accessToken String? @map("access_token")
  tokenScope  String? @map("token_scope")
  createdAt  DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerId])
  @@index([userId])
  @@map("oauth_accounts")
}

model Project {
  id          String   @id @default(uuid())
  userId      String   @map("user_id")
  name        String
  folderName  String   @map("folder_name")
  description String?  @db.Text
  type        ProjectType @default(template)
  template    String?
  languages    String[]

  containerStatus ContainerStatus @default(pending) @map("container_status")

  importSource    String?  @map("import_source")
  repoUrl         String?  @map("repo_url")
  repoBranch      String?  @map("repo_branch")
  zipKey          String?  @map("zip_key")

  runCommand      String?  @map("run_command")
  previewCommand  String?  @map("preview_command")
  previewPort     Int?     @map("preview_port")
  installCommand  String?  @map("install_command")

  envVars         Json?    @map("env_vars")
  autoSaveEnabled Boolean  @default(true) @map("auto_save_enabled")

  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  files           ProjectFile[]
  containerLogs   ContainerLog[]
  executionLogs   ExecutionLog[]

  snapshots ProjectSnapshot[]
  
  @@index([userId])
  @@index([languages])
  @@map("projects")
}

model ProjectFile {
  id         String   @id @default(uuid())
  projectId  String   @map("project_id")
  filePath   String   @map("file_path")
  fileName   String   @map("file_name")

  // content is populated for small files (<50KB), null for large files stored in MinIO
  content    String?  @db.Text
  minioPath  String   @map("minio_path")

  sizeBytes  BigInt   @map("size_bytes")
  mimeType   String?  @map("mime_type")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, filePath])
  @@index([projectId])
  @@index([filePath])
  @@index([fileName])
  @@map("project_files")
}

model ProjectSnapshot {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  userId      String   @map("user_id")
  minioKey    String   @map("minio_key")
  sizeBytes   BigInt   @map("size_bytes")
  fileCount   Int      @map("file_count")
  createdAt   DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([createdAt(sort: Desc)])
  @@map("project_snapshots")
}

model ContainerLog {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  containerId String   @map("container_id")
  logType     String   @map("log_type") // 'stdout', 'stderr', 'system'
  message     String   @db.Text
  timestamp   DateTime @default(now())

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([containerId])
  @@index([timestamp(sort: Desc)])
  @@map("container_logs")
}

model ExecutionLog {
  id          String   @id @default(uuid())
  projectId   String   @map("project_id")
  userId      String   @map("user_id")
  executionId String   @unique @map("execution_id")
  status      String   // 'queued', 'running', 'completed', 'failed', 'timeout'
  output      String?  @db.Text
  error       String?  @db.Text
  exitCode    Int?     @map("exit_code")
  durationMs  Int?     @map("duration_ms")
  memoryUsed  BigInt?  @map("memory_used")
  cpuUsed     Float?   @map("cpu_used")
  createdAt   DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  command     String?  @db.Text
  isDevServer Boolean @default(false) @map("is_dev_server")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([userId])
  @@index([executionId])
  @@index([status])
  @@index([createdAt(sort: Desc)])
  @@map("execution_logs")
}
