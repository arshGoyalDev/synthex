{
  "name": "@synthex/database",
  "version": "0.0.1",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "build": "tsc --outDir dist --noEmit false",
    "generate": "dotenv -e ../../.env -- prisma generate",
    "migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "migrate:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "studio": "dotenv -e ../../.env -- prisma studio",
    "push": "dotenv -e ../../.env -- prisma db push",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@prisma/client": "^6.3.0",
    "ioredis": "^5.3.2",
    "minio": "^7.1.3"
  },
  "devDependencies": {
    "@synthex/config": "workspace:*",
    "prisma": "^6.3.0",
    "typescript": "^5.3.0"
  }
}
